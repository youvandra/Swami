# systemd unit for a VPS deploy. Copy the built app to /opt/swami (rsync), keep the env in /opt/swami/.env.local
# (chmod 600), then: systemctl enable --now swami
[Unit]
Description=Swami (Next.js)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/swami
EnvironmentFile=/opt/swami/.env.local
Environment=NODE_ENV=production PORT=5192
ExecStart=/usr/bin/env npx next start -p 5192
Restart=on-failure
RestartSec=5
# a chat run holds a few MB; this keeps a leak from taking the box down
MemoryMax=768M

[Install]
WantedBy=multi-user.target
