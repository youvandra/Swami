# Qloo. Empty = labelled fake fixture.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Agent. Set ANTHROPIC_API_KEY, or all three LLM_* for an OpenAI-compatible endpoint. Empty = template prose.
ANTHROPIC_API_KEY=
SWAMI_MODEL=claude-sonnet-5-5
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Supabase. Empty = local-only mode (workspace data stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 1 = show "Continue with Google" (switch the Google provider on in Supabase Auth first)
NEXT_PUBLIC_AUTH_GOOGLE=
# test-only account for npm run smoke with accounts on (created with the service key on first run)
SMOKE_EMAIL=
SMOKE_PASSWORD=
# local only: chat runs without a session (ignored in production)
SWAMI_DEV_NO_AUTH=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:5192
SWAMI_DAILY_RUNS_PER_WORKSPACE=200
# Demo only: make each fake Qloo call take this long, so steps stream the way they do live.
SWAMI_FIXTURE_DELAY_MS=0
